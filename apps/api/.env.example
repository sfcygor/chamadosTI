# ─── Banco de Dados ──────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASS@ep-XXXXX.REGION.aws.neon.tech/atendeti?sslmode=require"
DIRECT_URL="postgresql://USER:PASS@ep-XXXXX.REGION.aws.neon.tech/atendeti?sslmode=require"

# ─── JWT (mantenha os mesmos valores do .env local) ──────────────────
JWT_SECRET="troque-por-secret-longo-e-aleatorio"
JWT_EXPIRES_IN="7d"
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"

# ─── Servidor ────────────────────────────────────────────────────────
PORT=3001
UPLOADS_DIR="./uploads"

# ─── CORS ────────────────────────────────────────────────────────────
# Liste todos os domínios permitidos separados por vírgula
# Exemplo: https://atendeti.vercel.app,https://meudominio.com
CORS_ORIGINS="https://SEU-APP.vercel.app"
